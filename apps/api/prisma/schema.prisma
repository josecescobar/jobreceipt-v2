generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum UserRole {
  OWNER
  BOOKKEEPER
  CREW
}

enum OrgPlan {
  FREE
  PRO
  CREW
}

enum JobStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ReceiptStatus {
  PROCESSING
  REVIEW
  APPROVED
  REJECTED
}

enum CostCodeCategory {
  MATERIALS
  LABOR
  EQUIPMENT
  SUBCONTRACTOR
  OVERHEAD
}

enum MaterialCategory {
  LUMBER
  ELECTRICAL
  PLUMBING
  ROOFING
  HARDWARE
  PAINT
  FASTENERS
  CONCRETE
  INSULATION
  DRYWALL
  FLOORING
  TOOLS
  SAFETY
  OTHER
}

enum PaymentMethod {
  CASH
  CREDIT
  DEBIT
  CHECK
  ACCOUNT
}

enum SyncDirection {
  PUSH
  PULL
}

enum SyncStatus {
  PENDING
  SUCCESS
  FAILED
}

enum RecurringExpenseFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum DocumentType {
  CONTRACT
  PERMIT
  INSURANCE
  LIEN_WAIVER
  W9
  OTHER
}

enum WeatherCondition {
  SUNNY
  CLOUDY
  RAINY
  SNOWY
  WINDY
}

enum CrewAssignmentStatus {
  SCHEDULED
  COMPLETED
  NO_SHOW
}

enum PunchListItemStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

enum PunchListItemPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum EquipmentStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  RETIRED
}

enum MaintenanceType {
  INSPECTION
  REPAIR
  SERVICING
  CALIBRATION
  OTHER
}

enum CloseOutChecklistItemStatus {
  PENDING
  COMPLETE
  WAIVED
}

// ─── Warranty Enums ─────────────────────────────────────

enum WarrantyStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  CLAIMED
}

enum WarrantyClaimStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DENIED
}

// ─── Permit Enums ───────────────────────────────────────

enum PermitType {
  BUILDING
  ELECTRICAL
  PLUMBING
  MECHANICAL
  FIRE
  DEMOLITION
  GRADING
  OTHER
}

enum PermitStatus {
  APPLIED
  ISSUED
  EXPIRED
  REVOKED
  CLOSED
}

enum InspectionResult {
  PASSED
  FAILED
  PARTIAL
  PENDING
}

// ─── Safety Enums ───────────────────────────────────────

enum SafetyInspectionStatus {
  OPEN
  COMPLETE
}

enum IncidentType {
  INJURY
  NEAR_MISS
  PROPERTY_DAMAGE
  ENVIRONMENTAL
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

// ─── Progress Billing Enums ─────────────────────────────

enum DrawRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PAID
}

// ─── Models ──────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique
  email     String
  name      String?
  phone     String?
  role      UserRole @default(OWNER)
  pushToken         String?
  notificationPrefs Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedOrganizations       Organization[]       @relation("OrgOwner")
  memberships              OrganizationMember[]
  uploadedReceipts         Receipt[]            @relation("ReceiptUploader")
  createdExpenses          Expense[]            @relation("ExpenseCreator")
  approvedExpenses         Expense[]            @relation("ExpenseApprover")
  mileageTrips             MileageTrip[]
  createdRecurringExpenses RecurringExpense[]   @relation("RecurringExpenseCreator")
  uploadedJobPhotos        JobPhoto[]           @relation("JobPhotoUploader")
  createdExpenseTemplates  ExpenseTemplate[]    @relation("ExpenseTemplateCreator")
  createdInvoices          Invoice[]            @relation("InvoiceCreator")
  timeEntries              TimeEntry[]
  createdEstimates         Estimate[]       @relation("EstimateCreator")
  createdChangeOrders      ChangeOrder[]    @relation("ChangeOrderCreator")
  approvedChangeOrders     ChangeOrder[]    @relation("ChangeOrderApprover")
  createdRecurringInvoices RecurringInvoice[] @relation("RecurringInvoiceCreator")
  createdJobTemplates      JobTemplate[]    @relation("JobTemplateCreator")
  createdVendors           Vendor[]         @relation("VendorCreator")
  createdSubcontractors    Subcontractor[]  @relation("SubcontractorCreator")
  createdCustomers         Customer[]       @relation("CustomerCreator")
  uploadedDocuments        Document[]       @relation("DocumentUploader")
  dailyLogs                DailyLog[]       @relation("DailyLogCreator")
  dailyLogPhotos           DailyLogPhoto[]  @relation("DailyLogPhotoUploader")
  crewAssignments          CrewAssignment[] @relation("CrewAssignmentUser")
  createdCrewAssignments   CrewAssignment[] @relation("CrewAssignmentCreator")
  createdPunchListItems    PunchListItem[]  @relation("PunchListCreator")
  punchListAssignments     PunchListItem[]  @relation("PunchListAssignee")
  punchListCompletions     PunchListItem[]  @relation("PunchListCompleter")
  punchListPhotos          PunchListPhoto[] @relation("PunchListPhotoUploader")
  sentMessages             Message[]        @relation("MessageSender")
  sentInvoiceReminders     InvoiceReminder[] @relation("ReminderSender")
  createdMaterialItems     MaterialItem[]   @relation("MaterialCreator")
  materialUsageLogs        MaterialUsageLog[] @relation("MaterialLogger")
  createdEquipment         Equipment[]      @relation("EquipmentCreator")
  equipmentCheckOuts       EquipmentAssignment[] @relation("EquipmentCheckOut")
  equipmentCheckIns        EquipmentAssignment[] @relation("EquipmentCheckIn")
  maintenanceLogs          MaintenanceLog[] @relation("MaintenancePerformer")
  initiatedCloseOuts       JobCloseOut[]    @relation("CloseOutInitiator")
  completedChecklistItems  CloseOutChecklistItem[] @relation("ChecklistCompleter")
  createdWarranties         Warranty[]            @relation("WarrantyCreator")
  createdWarrantyClaims     WarrantyClaim[]       @relation("WarrantyClaimCreator")
  createdPermits            Permit[]              @relation("PermitCreator")
  createdPermitInspections  PermitInspection[]    @relation("InspectionCreator")
  createdSafetyInspections  SafetyInspection[]    @relation("SafetyInspectionCreator")
  completedSafetyInspections SafetyInspection[]   @relation("SafetyInspectionCompleter")
  createdSafetyIncidents    SafetyIncident[]      @relation("IncidentCreator")
  reportedSafetyIncidents   SafetyIncident[]      @relation("IncidentReporter")
  incidentPhotos            SafetyIncidentPhoto[] @relation("IncidentPhotoUploader")
  createdSOVs               ScheduleOfValues[]    @relation("SOVCreator")
  createdDrawRequests       DrawRequest[]         @relation("DrawRequestCreator")
  approvedDrawRequests      DrawRequest[]         @relation("DrawRequestApprover")

  @@index([email])
}

model Organization {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  ownerId          String
  plan             OrgPlan  @default(FREE)
  stripeCustomerId String?
  qbRealmId        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  owner   User                 @relation("OrgOwner", fields: [ownerId], references: [id])
  members OrganizationMember[]
  jobs    Job[]
  costCodes          CostCode[]
  receipts           Receipt[]
  expenses           Expense[]
  mileageTrips       MileageTrip[]
  recurringExpenses  RecurringExpense[]
  jobPhotos          JobPhoto[]
  expenseTemplates   ExpenseTemplate[]
  invoices           Invoice[]
  timeEntries        TimeEntry[]
  estimates          Estimate[]
  changeOrders       ChangeOrder[]
  recurringInvoices  RecurringInvoice[]
  jobTemplates       JobTemplate[]
  vendors            Vendor[]
  subcontractors     Subcontractor[]
  customers          Customer[]
  documents          Document[]
  dailyLogs          DailyLog[]
  crewAssignments    CrewAssignment[]
  punchListItems     PunchListItem[]
  messages           Message[]
  materialItems      MaterialItem[]
  equipment          Equipment[]
  equipmentAssignments EquipmentAssignment[]
  jobCloseOuts       JobCloseOut[]
  quickBooksConnection QuickBooksConnection?
  syncLogs           SyncLog[]
  warranties           Warranty[]
  permits              Permit[]
  safetyInspections    SafetyInspection[]
  safetyIncidents      SafetyIncident[]
  schedulesOfValues    ScheduleOfValues[]
  drawRequests         DrawRequest[]
}

model OrganizationMember {
  id             String    @id @default(uuid())
  userId         String
  organizationId String
  role           UserRole  @default(CREW)
  invitedAt      DateTime  @default(now())
  acceptedAt     DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Job {
  id               String    @id @default(uuid())
  organizationId   String
  name             String
  customerId       String?
  customerName     String?
  customerAddress  String?
  customerLat      Float?
  customerLng      Float?
  status           JobStatus @default(ACTIVE)
  budgetTotal      Int?      // cents
  budgetMaterials  Int?      // cents
  budgetLabor      Int?      // cents
  contractValue         Int?      // cents - what the customer pays for the job
  marginAlertThreshold  Int?      // minimum acceptable margin % (0-100)
  marginAlertSentAt     DateTime? // tracks last margin alert to avoid repeats
  startDate             DateTime?
  endDate               DateTime?
  notes                 String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer          Customer?         @relation(fields: [customerId], references: [id])
  expenses          Expense[]
  lineItems         ReceiptLineItem[]
  mileageTrips      MileageTrip[]
  budgetSnapshots   BudgetSnapshot[]
  recurringExpenses RecurringExpense[]
  photos            JobPhoto[]
  invoices          Invoice[]
  timeEntries       TimeEntry[]
  estimates         Estimate[]
  changeOrders      ChangeOrder[]
  recurringInvoices RecurringInvoice[]
  documents         Document[]
  dailyLogs         DailyLog[]
  crewAssignments   CrewAssignment[]
  punchListItems    PunchListItem[]
  messages          Message[]
  materialItems     MaterialItem[]
  materialUsageLogs MaterialUsageLog[]
  equipmentAssignments EquipmentAssignment[]
  closeOut          JobCloseOut?
  warranties           Warranty[]
  permits              Permit[]
  safetyInspections    SafetyInspection[]
  safetyIncidents      SafetyIncident[]
  scheduleOfValues     ScheduleOfValues?

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([customerId])
}

model CostCode {
  id             String           @id @default(uuid())
  organizationId String
  code           String
  name           String
  category       CostCodeCategory
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lineItems         ReceiptLineItem[]
  expenses          Expense[]
  recurringExpenses RecurringExpense[]
  expenseTemplates  ExpenseTemplate[]
  changeOrderLineItems ChangeOrderLineItem[]
  jobTemplateLineItems JobTemplateLineItem[]
  vendorDefaults       Vendor[]             @relation("VendorDefaultCostCode")
  materialItems        MaterialItem[]
  sovItems             ScheduleOfValuesItem[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Receipt {
  id              String        @id @default(uuid())
  organizationId  String
  uploadedById    String
  imageUrl        String
  thumbnailUrl    String?
  status          ReceiptStatus @default(PROCESSING)
  ocrRawJson      Json?
  merchantName    String?
  merchantAddress String?
  subtotal        Int?          // cents
  taxAmount       Int?          // cents
  totalAmount     Int?          // cents
  transactionDate DateTime?
  currency        String        @default("USD")
  processedAt     DateTime?
  confidenceScore String?       // "high" | "medium" | "low"
  suggestedJobId    String?
  suggestedCategory String?
  autoAssigned    Boolean       @default(false)
  duplicateOfId   String?
  vendorId        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User              @relation("ReceiptUploader", fields: [uploadedById], references: [id])
  duplicateOf  Receipt?          @relation("ReceiptDuplicate", fields: [duplicateOfId], references: [id])
  duplicates   Receipt[]         @relation("ReceiptDuplicate")
  vendor       Vendor?           @relation(fields: [vendorId], references: [id])
  lineItems    ReceiptLineItem[]
  expenses     Expense[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, transactionDate])
}

model ReceiptLineItem {
  id                     String           @id @default(uuid())
  receiptId              String
  description            String
  sku                    String?
  quantity               Float            @default(1)
  unitPrice              Int              // cents
  totalPrice             Int              // cents
  isConstructionMaterial Boolean          @default(false)
  materialCategory       MaterialCategory?
  costCodeId             String?
  jobId                  String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  receipt  Receipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  costCode CostCode? @relation(fields: [costCodeId], references: [id])
  job      Job?      @relation(fields: [jobId], references: [id])

  @@index([receiptId])
  @@index([jobId])
}

model Expense {
  id             String    @id @default(uuid())
  organizationId String
  receiptId      String?
  jobId          String
  costCodeId     String?
  amount         Int       // cents
  description    String
  category       String?
  taxCategory    String?
  mileage        Float?
  imageKey       String?
  date           DateTime
  createdById    String
  approvedById   String?
  approvedAt       DateTime?
  subcontractorId  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receipt        Receipt?      @relation(fields: [receiptId], references: [id])
  job            Job           @relation(fields: [jobId], references: [id])
  costCode       CostCode?     @relation(fields: [costCodeId], references: [id])
  createdBy      User          @relation("ExpenseCreator", fields: [createdById], references: [id])
  approvedBy     User?         @relation("ExpenseApprover", fields: [approvedById], references: [id])
  subcontractor  Subcontractor? @relation(fields: [subcontractorId], references: [id])
  invoiceLineItems InvoiceLineItem[]

  @@index([organizationId])
  @@index([organizationId, jobId])
  @@index([organizationId, date])
}

model MileageTrip {
  id             String   @id @default(uuid())
  organizationId String
  jobId          String
  userId         String
  startLat       Float
  startLng       Float
  endLat         Float
  endLng         Float
  distanceMiles  Float
  irsRate        Int      // cents per mile
  totalDeduction Int      // cents
  date           DateTime
  purpose        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job          @relation(fields: [jobId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([organizationId, jobId])
}

model QuickBooksConnection {
  id             String    @id @default(uuid())
  organizationId String    @unique
  realmId        String
  accessToken    String
  refreshToken   String
  tokenExpiresAt DateTime
  lastSyncAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model SyncLog {
  id             String        @id @default(uuid())
  organizationId String
  entityType     String
  entityId       String
  qbId           String?
  syncDirection  SyncDirection
  status         SyncStatus    @default(PENDING)
  errorMessage   String?
  syncedAt       DateTime      @default(now())
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([entityType, entityId])
}

model BudgetSnapshot {
  id              String   @id @default(uuid())
  jobId           String
  totalBudget     Int      // cents
  totalSpent      Int      // cents
  totalRemaining  Int      // cents
  materialsBudget Int      // cents
  materialsSpent  Int      // cents
  laborBudget     Int      // cents
  laborSpent      Int      // cents
  snapshotDate    DateTime
  createdAt       DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([jobId, snapshotDate])
}

model RecurringExpense {
  id             String                    @id @default(uuid())
  organizationId String
  jobId          String
  costCodeId     String?
  amount         Int                       // cents
  description    String
  category       String?
  taxCategory    String?
  frequency      RecurringExpenseFrequency
  isActive       Boolean                   @default(true)
  nextOccurrence DateTime
  lastCreatedAt  DateTime?
  startDate      DateTime
  endDate        DateTime?
  createdById    String
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job          @relation(fields: [jobId], references: [id])
  costCode     CostCode?    @relation(fields: [costCodeId], references: [id])
  createdBy    User         @relation("RecurringExpenseCreator", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([isActive, nextOccurrence])
}

model JobPhoto {
  id               String   @id @default(uuid())
  jobId            String
  organizationId   String
  imageKey         String
  caption          String?
  annotationsJson  Json?
  annotatedImageKey String?
  uploadedById     String
  createdAt        DateTime @default(now())

  job          Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation("JobPhotoUploader", fields: [uploadedById], references: [id])

  @@index([jobId])
  @@index([organizationId])
}

model ExpenseTemplate {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  amount         Int?     // cents
  category       String?
  taxCategory    String?
  costCodeId     String?
  merchantName   String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  costCode     CostCode?    @relation(fields: [costCodeId], references: [id])
  createdBy    User         @relation("ExpenseTemplateCreator", fields: [createdById], references: [id])

  @@index([organizationId])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
}

enum InvoicePaymentMethod {
  CASH
  CHECK
  BANK_TRANSFER
  CREDIT_CARD
  OTHER
}

model Invoice {
  id             String        @id @default(uuid())
  organizationId String
  jobId          String
  invoiceNumber  String
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime      @default(now())
  dueDate        DateTime?
  notes          String?
  subtotal       Int           @default(0) // cents
  taxRate        Float         @default(0) // e.g. 0.08 for 8%
  taxAmount      Int           @default(0) // cents
  total          Int           @default(0) // cents
  paidAmount     Int           @default(0) // cents — denormalized sum of payments
  shareToken     String?       @unique
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job             @relation(fields: [jobId], references: [id])
  createdBy    User            @relation("InvoiceCreator", fields: [createdById], references: [id])
  lineItems    InvoiceLineItem[]
  payments     InvoicePayment[]
  reminders    InvoiceReminder[]
  convertedFromEstimate Estimate? @relation("EstimateInvoice")
  drawRequest          DrawRequest?

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([organizationId, jobId])
  @@index([organizationId, status])
}

model InvoiceLineItem {
  id          String   @id @default(uuid())
  invoiceId   String
  expenseId   String?
  description String
  quantity    Float    @default(1)
  unitPrice   Int      // cents
  total       Int      // cents
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  expense Expense? @relation(fields: [expenseId], references: [id])

  @@index([invoiceId])
}

model InvoicePayment {
  id        String               @id @default(uuid())
  invoiceId String
  amount    Int                  // cents
  date      DateTime
  method    InvoicePaymentMethod
  note      String?
  createdAt DateTime             @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model TimeEntry {
  id              String   @id @default(uuid())
  organizationId  String
  jobId           String
  userId          String
  date            DateTime
  startTime       String?  // "09:00" format
  endTime         String?  // "17:00" format
  durationMinutes Int       // total minutes worked
  hourlyRate      Int       // cents per hour
  totalCost       Int       // cents — precomputed: (durationMinutes / 60) * hourlyRate
  overtimeMinutes Int       @default(0)  // minutes beyond regular hours
  overtimeRate    Int?      // overtime rate cents/hr (null = 1.5x hourlyRate)
  isRunning       Boolean   @default(false) // active timer indicator
  clockInAt       DateTime? // exact clock-in timestamp for active timer
  description     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job          @relation(fields: [jobId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([organizationId, jobId])
  @@index([organizationId, date])
  @@index([organizationId, userId, isRunning])
}

// ─── Estimates ────────────────────────────────────────────

enum EstimateStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

model Estimate {
  id                 String         @id @default(uuid())
  organizationId     String
  jobId              String
  estimateNumber     String
  status             EstimateStatus @default(DRAFT)
  issueDate          DateTime       @default(now())
  expiresAt          DateTime?
  notes              String?
  subtotal           Int            @default(0) // cents
  taxRate            Float          @default(0)
  taxAmount          Int            @default(0) // cents
  total              Int            @default(0) // cents
  convertedInvoiceId String?        @unique
  shareToken         String?        @unique
  createdById        String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job              Job                @relation(fields: [jobId], references: [id])
  createdBy        User               @relation("EstimateCreator", fields: [createdById], references: [id])
  convertedInvoice Invoice?           @relation("EstimateInvoice", fields: [convertedInvoiceId], references: [id])
  lineItems        EstimateLineItem[]

  @@unique([organizationId, estimateNumber])
  @@index([organizationId])
  @@index([organizationId, jobId])
  @@index([organizationId, status])
}

model EstimateLineItem {
  id          String   @id @default(uuid())
  estimateId  String
  description String
  quantity    Float    @default(1)
  unitPrice   Int      // cents
  total       Int      // cents
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
}

// ─── Change Orders ────────────────────────────────────────

enum ChangeOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model ChangeOrder {
  id                String            @id @default(uuid())
  organizationId    String
  jobId             String
  changeOrderNumber String
  status            ChangeOrderStatus @default(DRAFT)
  title             String
  description       String?
  reason            String?
  subtotal          Int               @default(0) // cents
  taxRate           Float             @default(0)
  taxAmount         Int               @default(0) // cents
  total             Int               @default(0) // cents
  approvedById      String?
  approvedAt        DateTime?
  createdById       String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job                    @relation(fields: [jobId], references: [id])
  createdBy    User                   @relation("ChangeOrderCreator", fields: [createdById], references: [id])
  approvedBy   User?                  @relation("ChangeOrderApprover", fields: [approvedById], references: [id])
  lineItems    ChangeOrderLineItem[]

  @@unique([organizationId, changeOrderNumber])
  @@index([organizationId])
  @@index([organizationId, jobId])
}

model ChangeOrderLineItem {
  id            String   @id @default(uuid())
  changeOrderId String
  description   String
  quantity      Float    @default(1)
  unitPrice     Int      // cents
  total         Int      // cents
  costCodeId    String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  changeOrder ChangeOrder @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)
  costCode    CostCode?   @relation(fields: [costCodeId], references: [id])

  @@index([changeOrderId])
}

// ─── Recurring Invoices ──────────────────────────────────

model RecurringInvoice {
  id             String                    @id @default(uuid())
  organizationId String
  jobId          String
  isActive       Boolean                   @default(true)
  frequency      RecurringExpenseFrequency
  nextOccurrence DateTime
  lastCreatedAt  DateTime?
  startDate      DateTime
  endDate        DateTime?
  notes          String?
  taxRate        Float                     @default(0)
  createdById    String
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job                        @relation(fields: [jobId], references: [id])
  createdBy    User                       @relation("RecurringInvoiceCreator", fields: [createdById], references: [id])
  lineItems    RecurringInvoiceLineItem[]

  @@index([organizationId])
  @@index([isActive, nextOccurrence])
}

model RecurringInvoiceLineItem {
  id                 String   @id @default(uuid())
  recurringInvoiceId String
  description        String
  quantity           Float    @default(1)
  unitPrice          Int      // cents
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  recurringInvoice RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)

  @@index([recurringInvoiceId])
}

// ─── Job Templates ───────────────────────────────────────

model JobTemplate {
  id              String   @id @default(uuid())
  organizationId  String
  name            String
  description     String?
  customerName    String?
  budgetTotal     Int?     // cents
  budgetMaterials Int?     // cents
  budgetLabor     Int?     // cents
  contractValue   Int?     // cents
  notes           String?
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User                   @relation("JobTemplateCreator", fields: [createdById], references: [id])
  lineItems    JobTemplateLineItem[]

  @@index([organizationId])
}

model JobTemplateLineItem {
  id              String   @id @default(uuid())
  templateId      String
  description     String
  category        String?
  estimatedAmount Int?     // cents
  costCodeId      String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  template JobTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  costCode CostCode?   @relation(fields: [costCodeId], references: [id])

  @@index([templateId])
}

// ─── Vendors ────────────────────────────────────────────

model Vendor {
  id                String   @id @default(uuid())
  organizationId    String
  name              String
  contactName       String?
  phone             String?
  email             String?
  address           String?
  website           String?
  defaultCategory   String?
  defaultCostCodeId String?
  notes             String?
  createdById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultCostCode CostCode?    @relation("VendorDefaultCostCode", fields: [defaultCostCodeId], references: [id])
  createdBy       User         @relation("VendorCreator", fields: [createdById], references: [id])
  receipts        Receipt[]
  documents       Document[]

  @@index([organizationId])
}

// ─── Subcontractors ─────────────────────────────────────

model Subcontractor {
  id              String    @id @default(uuid())
  organizationId  String
  name            String
  companyName     String?
  phone           String?
  email           String?
  address         String?
  trade           String?
  licenseNumber   String?
  insuranceExpiry DateTime?
  w9Received      Boolean   @default(false)
  notes           String?
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User          @relation("SubcontractorCreator", fields: [createdById], references: [id])
  expenses     Expense[]
  documents    Document[]

  @@index([organizationId])
}

// ─── Customers ──────────────────────────────────────────

model Customer {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  companyName    String?
  email          String?
  phone          String?
  address        String?
  city           String?
  state          String?
  zip            String?
  notes          String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User          @relation("CustomerCreator", fields: [createdById], references: [id])
  jobs         Job[]

  @@index([organizationId])
  @@index([organizationId, name])
}

// ─── Documents ──────────────────────────────────────────

model Document {
  id                String       @id @default(uuid())
  organizationId    String
  name              String
  type              DocumentType @default(OTHER)
  fileKey           String
  fileType          String
  fileSize          Int
  jobId             String?
  vendorId          String?
  subcontractorId   String?
  expiresAt         DateTime?
  notes             String?
  uploadedById      String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy    User           @relation("DocumentUploader", fields: [uploadedById], references: [id])
  job           Job?           @relation(fields: [jobId], references: [id])
  vendor        Vendor?        @relation(fields: [vendorId], references: [id])
  subcontractor Subcontractor? @relation(fields: [subcontractorId], references: [id])
  warranties    Warranty[]
  permits       Permit[]

  @@index([organizationId])
  @@index([jobId])
  @@index([vendorId])
  @@index([subcontractorId])
}

// ─── Daily Logs ─────────────────────────────────────────

model DailyLog {
  id             String            @id @default(uuid())
  organizationId String
  jobId          String
  userId         String
  date           DateTime
  weather        WeatherCondition?
  temperature    Int?
  crewCount      Int?
  workPerformed  String
  materialsUsed  String?
  safetyNotes    String?
  hoursWorked    Float?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job             @relation(fields: [jobId], references: [id])
  user         User            @relation("DailyLogCreator", fields: [userId], references: [id])
  photos       DailyLogPhoto[]

  @@unique([jobId, userId, date])
  @@index([organizationId])
  @@index([jobId])
  @@index([organizationId, date])
}

model DailyLogPhoto {
  id           String   @id @default(uuid())
  dailyLogId   String
  imageKey     String
  caption      String?
  uploadedById String
  createdAt    DateTime @default(now())

  dailyLog   DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation("DailyLogPhotoUploader", fields: [uploadedById], references: [id])

  @@index([dailyLogId])
}

// ─── Crew Scheduling ────────────────────────────────────

model CrewAssignment {
  id             String               @id @default(uuid())
  organizationId String
  jobId          String
  userId         String
  date           DateTime
  startTime      String?              // "09:00" format
  endTime        String?              // "17:00" format
  notes          String?
  status         CrewAssignmentStatus @default(SCHEDULED)
  createdById    String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job          @relation(fields: [jobId], references: [id])
  user         User         @relation("CrewAssignmentUser", fields: [userId], references: [id])
  createdBy    User         @relation("CrewAssignmentCreator", fields: [createdById], references: [id])

  @@unique([jobId, userId, date])
  @@index([organizationId])
  @@index([organizationId, date])
  @@index([userId, date])
  @@index([jobId])
}

// ─── Punch Lists ──────────────────────────────────────

model PunchListItem {
  id             String                @id @default(uuid())
  organizationId String
  jobId          String
  title          String
  description    String?
  priority       PunchListItemPriority @default(MEDIUM)
  status         PunchListItemStatus   @default(OPEN)
  assignedToId   String?
  dueDate        DateTime?
  completedAt    DateTime?
  completedById  String?
  createdById    String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job              @relation(fields: [jobId], references: [id])
  assignedTo   User?            @relation("PunchListAssignee", fields: [assignedToId], references: [id])
  completedBy  User?            @relation("PunchListCompleter", fields: [completedById], references: [id])
  createdBy    User             @relation("PunchListCreator", fields: [createdById], references: [id])
  photos       PunchListPhoto[]

  @@index([organizationId])
  @@index([jobId])
  @@index([jobId, status])
  @@index([assignedToId])
}

model PunchListPhoto {
  id              String   @id @default(uuid())
  punchListItemId String
  imageKey        String
  caption         String?
  uploadedById    String
  createdAt       DateTime @default(now())

  punchListItem PunchListItem @relation(fields: [punchListItemId], references: [id], onDelete: Cascade)
  uploadedBy    User          @relation("PunchListPhotoUploader", fields: [uploadedById], references: [id])

  @@index([punchListItemId])
}

// ─── Messages ─────────────────────────────────────────

model Message {
  id             String   @id @default(uuid())
  organizationId String
  jobId          String
  senderId       String
  body           String
  readBy         Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job          @relation(fields: [jobId], references: [id])
  sender       User         @relation("MessageSender", fields: [senderId], references: [id])

  @@index([organizationId])
  @@index([jobId])
  @@index([jobId, createdAt])
}

// ─── Invoice Reminders ────────────────────────────────

model InvoiceReminder {
  id        String   @id @default(uuid())
  invoiceId String
  sentAt    DateTime @default(now())
  type      String   // "7_day", "14_day", "30_day", "manual"
  sentById  String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sentBy  User?   @relation("ReminderSender", fields: [sentById], references: [id])

  @@index([invoiceId])
}

// ─── Materials ─────────────────────────────────────────

model MaterialItem {
  id             String            @id @default(uuid())
  organizationId String
  jobId          String
  name           String
  sku            String?
  unit           String            @default("ea")
  unitCost       Int               @default(0) // cents
  category       MaterialCategory?
  costCodeId     String?
  purchasedQty   Float             @default(0)
  usedQty        Float             @default(0)
  notes          String?
  createdById    String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job               @relation(fields: [jobId], references: [id])
  costCode     CostCode?         @relation(fields: [costCodeId], references: [id])
  createdBy    User              @relation("MaterialCreator", fields: [createdById], references: [id])
  usageLogs    MaterialUsageLog[]

  @@index([organizationId])
  @@index([jobId])
  @@index([jobId, category])
}

model MaterialUsageLog {
  id             String   @id @default(uuid())
  materialItemId String
  jobId          String
  qty            Float
  notes          String?
  loggedById     String
  loggedAt       DateTime @default(now())

  materialItem MaterialItem @relation(fields: [materialItemId], references: [id], onDelete: Cascade)
  job          Job          @relation(fields: [jobId], references: [id])
  loggedBy     User         @relation("MaterialLogger", fields: [loggedById], references: [id])

  @@index([materialItemId])
}

// ─── Equipment ─────────────────────────────────────────

model Equipment {
  id             String          @id @default(uuid())
  organizationId String
  name           String
  type           String?
  make           String?
  model          String?
  serialNumber   String?
  purchaseDate   DateTime?
  purchaseCost   Int?            // cents
  status         EquipmentStatus @default(AVAILABLE)
  imageKey       String?
  notes          String?
  createdById    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User                  @relation("EquipmentCreator", fields: [createdById], references: [id])
  assignments     EquipmentAssignment[]
  maintenanceLogs MaintenanceLog[]

  @@index([organizationId])
  @@index([organizationId, status])
}

model EquipmentAssignment {
  id             String    @id @default(uuid())
  organizationId String
  equipmentId    String
  jobId          String
  checkedOutAt   DateTime
  checkedInAt    DateTime?
  checkedOutById String
  checkedInById  String?
  notes          String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  equipment    Equipment    @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  job          Job          @relation(fields: [jobId], references: [id])
  checkedOutBy User         @relation("EquipmentCheckOut", fields: [checkedOutById], references: [id])
  checkedInBy  User?        @relation("EquipmentCheckIn", fields: [checkedInById], references: [id])

  @@index([equipmentId])
  @@index([jobId])
  @@index([equipmentId, checkedInAt])
}

model MaintenanceLog {
  id            String          @id @default(uuid())
  equipmentId   String
  type          MaintenanceType
  description   String?
  performedAt   DateTime
  performedById String?
  cost          Int?            // cents
  nextDueDate   DateTime?
  notes         String?
  createdAt     DateTime        @default(now())

  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  performedBy User?     @relation("MaintenancePerformer", fields: [performedById], references: [id])

  @@index([equipmentId])
}

// ─── Job Close-out ──────────────────────────────────────

model JobCloseOut {
  id                 String    @id @default(uuid())
  jobId              String    @unique
  organizationId     String
  initiatedById      String
  initiatedAt        DateTime  @default(now())
  completedAt        DateTime?
  customerSignature  String?
  customerSignedAt   DateTime?
  customerSignedName String?
  walkthroughDate    DateTime?
  walkthroughNotes   String?
  walkthroughPhotos  Json?
  punchListCleared   Boolean   @default(false)
  invoicesPaid       Boolean   @default(false)
  documentsComplete  Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  job            Job                     @relation(fields: [jobId], references: [id])
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  initiatedBy    User                    @relation("CloseOutInitiator", fields: [initiatedById], references: [id])
  checklistItems CloseOutChecklistItem[]

  @@index([organizationId])
}

model CloseOutChecklistItem {
  id            String                      @id @default(uuid())
  closeOutId    String
  label         String
  status        CloseOutChecklistItemStatus  @default(PENDING)
  completedAt   DateTime?
  completedById String?
  notes         String?
  sortOrder     Int                         @default(0)
  createdAt     DateTime                    @default(now())

  closeOut    JobCloseOut @relation(fields: [closeOutId], references: [id], onDelete: Cascade)
  completedBy User?       @relation("ChecklistCompleter", fields: [completedById], references: [id])

  @@index([closeOutId])
}

// ─── Warranties ─────────────────────────────────────────

model Warranty {
  id               String         @id @default(uuid())
  organizationId   String
  jobId            String
  title            String
  description      String?
  manufacturer     String?
  warrantyProvider String?
  startDate        DateTime
  endDate          DateTime
  status           WarrantyStatus @default(ACTIVE)
  contactPhone     String?
  contactEmail     String?
  documentId       String?
  notes            String?
  createdById      String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job              @relation(fields: [jobId], references: [id])
  document     Document?        @relation(fields: [documentId], references: [id])
  createdBy    User             @relation("WarrantyCreator", fields: [createdById], references: [id])
  claims       WarrantyClaim[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([jobId])
  @@index([endDate])
}

model WarrantyClaim {
  id          String              @id @default(uuid())
  warrantyId  String
  claimDate   DateTime
  description String
  status      WarrantyClaimStatus @default(OPEN)
  resolution  String?
  resolvedAt  DateTime?
  createdById String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  warranty  Warranty @relation(fields: [warrantyId], references: [id], onDelete: Cascade)
  createdBy User     @relation("WarrantyClaimCreator", fields: [createdById], references: [id])

  @@index([warrantyId])
}

// ─── Permits ────────────────────────────────────────────

model Permit {
  id             String       @id @default(uuid())
  organizationId String
  jobId          String
  permitNumber   String?
  type           PermitType   @default(OTHER)
  status         PermitStatus @default(APPLIED)
  appliedDate    DateTime?
  issuedDate     DateTime?
  expiresAt      DateTime?
  authority      String?
  fee            Int?         // cents
  documentId     String?
  notes          String?
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job                  @relation(fields: [jobId], references: [id])
  document     Document?            @relation(fields: [documentId], references: [id])
  createdBy    User                 @relation("PermitCreator", fields: [createdById], references: [id])
  inspections  PermitInspection[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([jobId])
  @@index([expiresAt])
}

model PermitInspection {
  id            String           @id @default(uuid())
  permitId      String
  scheduledDate DateTime
  completedDate DateTime?
  result        InspectionResult @default(PENDING)
  inspector     String?
  notes         String?
  createdById   String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  permit    Permit @relation(fields: [permitId], references: [id], onDelete: Cascade)
  createdBy User   @relation("InspectionCreator", fields: [createdById], references: [id])

  @@index([permitId])
  @@index([scheduledDate])
}

// ─── Safety ─────────────────────────────────────────────

model SafetyInspection {
  id             String                 @id @default(uuid())
  organizationId String
  jobId          String
  templateName   String
  status         SafetyInspectionStatus @default(OPEN)
  completedById  String?
  completedAt    DateTime?
  notes          String?
  createdById    String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job                      @relation(fields: [jobId], references: [id])
  completedBy  User?                    @relation("SafetyInspectionCompleter", fields: [completedById], references: [id])
  createdBy    User                     @relation("SafetyInspectionCreator", fields: [createdById], references: [id])
  items        SafetyInspectionItem[]

  @@index([organizationId])
  @@index([jobId])
}

model SafetyInspectionItem {
  id           String  @id @default(uuid())
  inspectionId String
  label        String
  isCompliant  Boolean @default(false)
  notes        String?
  sortOrder    Int     @default(0)

  inspection SafetyInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
}

model SafetyIncident {
  id             String           @id @default(uuid())
  organizationId String
  jobId          String
  reportedById   String
  incidentDate   DateTime
  type           IncidentType
  severity       IncidentSeverity
  title          String
  description    String
  location       String?
  witnesses      String?
  actionTaken    String?
  followUp       String?
  status         IncidentStatus   @default(OPEN)
  resolvedAt     DateTime?
  createdById    String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job                    @relation(fields: [jobId], references: [id])
  reportedBy   User                   @relation("IncidentReporter", fields: [reportedById], references: [id])
  createdBy    User                   @relation("IncidentCreator", fields: [createdById], references: [id])
  photos       SafetyIncidentPhoto[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([jobId])
}

model SafetyIncidentPhoto {
  id           String   @id @default(uuid())
  incidentId   String
  imageKey     String
  caption      String?
  uploadedById String
  createdAt    DateTime @default(now())

  incident   SafetyIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  uploadedBy User           @relation("IncidentPhotoUploader", fields: [uploadedById], references: [id])

  @@index([incidentId])
}

// ─── Progress Billing ───────────────────────────────────

model ScheduleOfValues {
  id               String   @id @default(uuid())
  organizationId   String
  jobId            String   @unique
  retainagePercent Float    @default(10)
  notes            String?
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job                     @relation(fields: [jobId], references: [id])
  createdBy    User                    @relation("SOVCreator", fields: [createdById], references: [id])
  items        ScheduleOfValuesItem[]
  drawRequests DrawRequest[]

  @@index([organizationId])
}

model ScheduleOfValuesItem {
  id             String   @id @default(uuid())
  scheduleId     String
  itemNumber     String
  description    String
  scheduledValue Int      // cents
  costCodeId     String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  schedule ScheduleOfValues   @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  costCode CostCode?          @relation(fields: [costCodeId], references: [id])
  entries  DrawRequestEntry[]

  @@index([scheduleId])
}

model DrawRequest {
  id                    String            @id @default(uuid())
  scheduleId            String
  organizationId        String
  applicationNumber     Int
  periodTo              DateTime
  invoiceId             String?           @unique
  status                DrawRequestStatus @default(DRAFT)
  totalEarned           Int               @default(0) // cents
  totalRetainage        Int               @default(0) // cents
  totalPreviouslyBilled Int               @default(0) // cents
  currentPaymentDue     Int               @default(0) // cents
  notes                 String?
  createdById           String
  approvedById          String?
  approvedAt            DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  schedule     ScheduleOfValues   @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice?           @relation(fields: [invoiceId], references: [id])
  createdBy    User               @relation("DrawRequestCreator", fields: [createdById], references: [id])
  approvedBy   User?              @relation("DrawRequestApprover", fields: [approvedById], references: [id])
  entries      DrawRequestEntry[]

  @@index([scheduleId])
  @@index([organizationId])
}

model DrawRequestEntry {
  id                        String @id @default(uuid())
  drawRequestId             String
  sovItemId                 String
  workCompletedPrevious     Int    @default(0) // cents
  workCompletedThisPeriod   Int    @default(0) // cents
  materialsStored           Int    @default(0) // cents
  totalCompletedAndStored   Int    @default(0) // cents
  percentComplete           Float  @default(0)
  balanceToFinish           Int    @default(0) // cents
  retainage                 Int    @default(0) // cents

  drawRequest DrawRequest          @relation(fields: [drawRequestId], references: [id], onDelete: Cascade)
  sovItem     ScheduleOfValuesItem @relation(fields: [sovItemId], references: [id])

  @@index([drawRequestId])
}
