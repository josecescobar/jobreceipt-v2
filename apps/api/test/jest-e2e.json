{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^@jobreceipt/shared$": "<rootDir>/../../packages/shared/src/index.ts",
    "^@shared/(.*)$": "<rootDir>/../../packages/shared/src/$1",
    "^@api/(.*)$": "<rootDir>/src/$1"
  }
}
